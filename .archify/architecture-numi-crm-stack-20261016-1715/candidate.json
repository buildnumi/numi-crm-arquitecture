  "cards": [
    {
      "dot": "cyan",
      "title": "Qué se despliega",
      "items": [
        "Solo dos Workers: el de la aplicación y el de la API",
        "Los tres consumidores y el trabajo programado viven dentro del Worker de la API",
        "Queues, R2, Hyperdrive, Postgres, Auth y Realtime son gestionados: cero servidores"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cloudflare",
      "items": [
        "Workers: runtime de la API con Hono y del servidor de archivos estáticos",
        "Queues: tres colas con tolerancias distintas y cola de fallidos obligatoria",
        "R2: adjuntos, siempre servidos por el Worker, nunca expuestos al navegador",
        "Hyperdrive: agrupa las conexiones a Postgres desde el borde"
      ]
    },
    {
      "dot": "violet",
      "title": "Supabase",
      "items": [
        "Postgres: dueño de todos los datos; RLS y tres roles sin bypassrls",
        "Auth: solo responde quién eres; la autorización vive en la API",
        "Realtime: Broadcast desde el servidor, canal por organización, sin contenido",
        "Plan gratuito: sin copias del proveedor. Latido diario en el cron y pg_dump propio hacia R2 (ADR-015)"
      ]
    },
    {
      "dot": "amber",
      "title": "Servicios externos",
      "items": [
        "Meta Cloud API: única puerta del canal, entrada y salida",
        "Anthropic: recibe el texto de la conversación, nunca el nombre, el teléfono ni los adjuntos",
        "Resend: correo con dominio propio; sin él no entran clientes nuevos"
      ]
    },
    {
      "dot": "slate",
      "title": "Costo fijo",
      "items": [
        "5 USD al mes: solo Workers; Supabase en plan gratuito (ADR-015)",
        "Variable: mensajes de Meta, tokens del agente y el dominio",
        "Sube a 30 USD al migrar a Supabase Pro, cuando el piloto valide la idea"
      ]
    }
  ]
}