  "cards": [
    { "dot": "cyan", "title": "Dos despliegues", "items": [
      "Worker de la app: solo archivos estáticos",
      "Worker de la API: webhook, rutas y los tres consumidores",
      "Colas, R2, Hyperdrive y Supabase son gestionados"
    ] },
    { "dot": "emerald", "title": "Entrada sin pérdidas", "items": [
      "Firma HMAC-SHA256 sobre el cuerpo crudo",
      "Evento crudo guardado antes del 200; Meta reintenta 7 días",
      "Unicidad (organization_id, wamid); orden por hora de Meta",
      "La suspensión bloquea la salida, nunca la entrada"
    ] },
    { "dot": "rose", "title": "Aislamiento y secretos", "items": [
      "Auth solo identifica; la API autoriza cada petición y verifica el JWT por JWKS",
      "app_platform no tiene permiso sobre las tablas de mensajes",
      "Tokens de WhatsApp cifrados con AES-GCM; nunca en el navegador"
    ] },
    { "dot": "violet", "title": "Tiempo real", "items": [
      "Tres escritores publican con una sola función",
      "El aviso no lleva contenido: la app invalida y recarga por la API",
      "Sin Realtime, la bandeja se actualiza cada 60 s"
    ] },
    { "dot": "amber", "title": "Envío y agente", "items": [
      "Envío síncrono: guarda «enviando», luego llama a Meta",
      "Ventana de 24 h verificada antes de llamar a Meta",
      "El agente reutiliza el camino de salida y escala tras dos fallos",
      "Anthropic recibe el texto, no el nombre, el teléfono ni adjuntos; exige HIPAA"
    ] },
    { "dot": "slate", "title": "Cola de archivos", "items": [
      "Los documentos no fijan quién encola la descarga: ADR-004 dice el webhook; con ADR-005 el webhook solo guarda el evento crudo, por eso se dibuja desde el consumidor"
    ] }
  ]
